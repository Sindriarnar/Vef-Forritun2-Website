# ------------------------------------------------------------------
# Template for environment variables.
#
# 1. Copy this file to `.env.local`   (cp .env.example .env.local)
# 2. Fill in real values in `.env.local`
#
# `.env.local` (and every other .env* file) is in .gitignore and will
# NOT be pushed to GitHub. Only this template is committed, so never
# put real API keys or passwords in this file.
#
# Variables WITHOUT the NEXT_PUBLIC_ prefix are only available on the
# server (server components, route handlers, the scraper). Variables
# WITH NEXT_PUBLIC_ are baked into the browser bundle — never put a
# secret in a NEXT_PUBLIC_ variable.
# ------------------------------------------------------------------

# Where the SQLite database file lives (relative to the project root).
DATABASE_PATH=./data/hvad.db

# How the scraper identifies itself to the sites it visits.
# Be honest here — it's polite and many sites block anonymous bots.
SCRAPER_USER_AGENT="HvadAdGeraBot/0.1 (student project; +https://github.com/Sindriarnar/Vef-Forritun2-Website)"

# Minimum pause between two requests to the same site, in milliseconds.
SCRAPER_DELAY_MS=2000

# Request timeout in milliseconds.
SCRAPER_TIMEOUT_MS=20000

# ------------------------------------------------------------------
# Future API keys go here (examples — none are used yet).
# Put the REAL values in .env.local only.
# ------------------------------------------------------------------
# GOOGLE_MAPS_API_KEY=
# KVIKMYNDIR_API_KEY=
