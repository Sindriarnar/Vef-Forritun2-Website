# What gets pushed to GitHub: only our own source code and config.
# Everything below is either installed by `npm install`, generated by a
# build/the scraper, personal, or secret — so it stays on your machine.
#
# Check what WOULD be committed before you commit:
#   git status
#   git add --dry-run .

# ---------------------------------------------------------------
# Libraries (re-installed with `npm install` from package-lock.json)
# ---------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------
# Build output and caches (re-created by `npm run dev` / `npm run build`)
# ---------------------------------------------------------------
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# Written by `next dev` for AI coding tools; not part of the site.
AGENTS.md

# ---------------------------------------------------------------
# Secrets / local environment — NEVER commit these.
# Every .env file is ignored except the template (.env.example),
# which must only ever contain placeholder values.
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem

# ---------------------------------------------------------------
# Local SQLite database created by the scraper (re-create it with
# `npm run scrape`)
# ---------------------------------------------------------------
/data/*
!/data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------
# Editors and operating systems (personal settings)
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local files (worktrees, personal settings)
/.claude/worktrees/
/.claude/settings.local.json

# Hosting
.vercel
